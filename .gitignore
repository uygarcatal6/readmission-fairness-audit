.ipynb_checkpoints/

# Model artefacts
*.pkl
*.joblib

# Approved-protocol runs: per-encounter predictions and checkpoints stay out (regenerable).
# Exception: the five summary JSONs of the full run (aggregate statistics only, ~2 MB), which
# the notebook, scripts/make_figures.py and slides/build_slides.py read.
outputs/approved*/*
!outputs/approved/summary.json
!outputs/approved/fairness.json
!outputs/approved/mitigation.json
!outputs/approved/sources.json
!outputs/approved/ordering.json

# Quick check runs (--quick)
outputs/reports/*_quick.md

# LaTeX build files (paper/main.pdf is not committed, see paper/README.md)
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/main.pdf

# Local notes (never committed)
notes/
